# Locale must be set for testing.postgresql to start a temporary Postgres process.
# Without this, tests requiring PostgreSQL fail with:
#   FATAL: postmaster became multithreaded during startup
LC_ALL=en_US.UTF-8
LANG=en_US.UTF-8

# Set this to enable MS-SQL tests (requires pyodbc: poetry install --extras mssql).
# Example:
#   MSSQL_TEST_DSN=mssql+pyodbc://sa:YourPassword@127.0.0.1:1433/master?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
MSSQL_TEST_DSN=
