--
-- Version of src.dump that works with DuckDB and includes hospital visits.
--
CREATE DATABASE src WITH TEMPLATE = template0 ENCODING = 'UTF8' ;

ALTER DATABASE src OWNER TO postgres;

\connect src

--
-- Name: concept; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.concept (
    concept_id integer NOT NULL,
    concept_name text NOT NULL,
    concept_type_id integer,
    concept_valid_from timestamp with time zone not null
);


ALTER TABLE public.concept OWNER TO postgres;

--
-- Name: concept_type; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.concept_type (
    id integer NOT NULL,
    name text NOT NULL,
    mitigation_type_id integer,
    lucky_number integer
);


ALTER TABLE public.concept_type OWNER TO postgres;

--
-- Name: hospital_visit; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.hospital_visit (
    hospital_visit_id bigint NOT NULL,
    person_id integer NOT NULL,
    visit_start date NOT NULL,
    visit_end date NOT NULL,
    visit_type_concept_id integer NOT NULL
);


ALTER TABLE public.hospital_visit OWNER TO postgres;

--
-- Name: mitigation_type; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.mitigation_type (
    id integer NOT NULL,
    name text,
    description text
);


ALTER TABLE public.mitigation_type OWNER TO postgres;

--
-- Name: no_pk_test; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.no_pk_test (
    not_an_id integer NOT NULL
);


ALTER TABLE public.no_pk_test OWNER TO postgres;

--
-- Name: empty_vocabulary; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.empty_vocabulary (
    entry_id integer NOT NULL,
    entry_name text NOT NULL
);

ALTER TABLE public.empty_vocabulary OWNER TO postgres;

--
-- Name: test_entity; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.test_entity (
    single_letter_column VARCHAR(1),
    vocabulary_entry_id integer
);

ALTER TABLE public.test_entity OWNER TO postgres;

--
-- Name: person; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.person (
    person_id integer NOT NULL,
    name text NOT NULL,
    research_opt_out boolean NOT NULL,
    stored_from timestamp with time zone NOT NULL
);


ALTER TABLE public.person OWNER TO postgres;

--
-- Name: unique_constraint_test; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.unique_constraint_test (
    id integer NOT NULL,
    a boolean NOT NULL,
    b boolean NOT NULL,
    c text NOT NULL
);


ALTER TABLE public.unique_constraint_test OWNER TO postgres;


--
-- Name: unique_constraint_test2; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.unique_constraint_test2 (
    id integer NOT NULL,
    a text NOT NULL,
    b text NOT NULL,
    c text NOT NULL
);


ALTER TABLE public.unique_constraint_test2 OWNER TO postgres;

--
-- Name: data_type_test; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.data_type_test (
    myuuid UUID NOT NULL
);

ALTER TABLE public.data_type_test OWNER TO postgres;

--
-- Name: unignorable_table; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.unignorable_table (
    id integer NOT NULL
);

ALTER TABLE public.unignorable_table OWNER TO postgres;

--
-- Name: ref_to_unignorable_table ; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.ref_to_unignorable_table  (
    id integer NOT NULL,
    ref integer NOT NULL
);

ALTER TABLE public.ref_to_unignorable_table OWNER TO postgres;

--
-- Name: table_to_be_ignored; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.table_to_be_ignored (
    id integer NOT NULL
);

ALTER TABLE public.table_to_be_ignored OWNER TO postgres;

